# Normalize line endings on commit; check out native (CRLF on Windows).
# Stops the "LF will be replaced by CRLF" warning storm.
* text=auto

# Keep specific file types LF regardless of platform
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf

# Treat as binary — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.exe binary
